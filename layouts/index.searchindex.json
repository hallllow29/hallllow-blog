{{- $items := slice -}}
{{- $pages := where site.RegularPages "Section" "in" (slice "posts" "research") -}}
{{- range $p := $pages -}}
  {{- $tags := default (slice) $p.Params.tags -}}
  {{- $cats := default (slice) $p.Params.categories -}}
  {{- with $p.Fragments -}}
    {{- range $id, $h := .HeadingsMap -}}
      {{- $title := $h.Title -}}
      {{- if $title -}}
        {{- $items = $items | append (dict
            "post"       $p.Title
            "section"    $title
            "url"        (printf "%s#%s" $p.RelPermalink $id)
            "tags"       $tags
            "categories" $cats
            "date"       ($p.Date.Format "2006-01-02")
        ) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
{{- $items | jsonify (dict "indent" "  ") -}}
